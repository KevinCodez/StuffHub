# Server-only. Never prefix these with NEXT_PUBLIC or EXPO_PUBLIC.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=copy-the-local-anon-key-from-pnpm-db-status
# Public web URL opened by password-recovery emails. Defaults to the requesting
# web origin when omitted.
# PASSWORD_RESET_REDIRECT_URL=https://stuffhub.example.com/?recovery=1

# Optional. Tesseract.js fetches English OCR language data on first use unless
# this points to an internally hosted directory containing eng.traineddata.gz.
# TESSERACT_LANG_PATH=https://cdn.example.com/tesseract-data

# Mobile talks to the StuffHub Next.js API, never to Supabase. Use your
# computer's LAN address for a physical device (for example 192.168.1.20).
EXPO_PUBLIC_STUFFHUB_API_URL=http://127.0.0.1:3000
