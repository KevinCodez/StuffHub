# StuffHub release image. Replace OWNER after the first image is published.
STUFFHUB_IMAGE=ghcr.io/OWNER/stuffhub:1.0.0

# Browser-facing addresses. Use HTTPS URLs when exposed outside your LAN.
APP_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
STUFFHUB_PORT=3000
SUPABASE_PORT=8000
COOKIE_SECURE=false

# Generated by ./generate-env.sh. Do not reuse the example values.
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-me-with-at-least-32-characters
ANON_KEY=replace-me
SERVICE_ROLE_KEY=replace-me
JWT_EXPIRY=3600

# New accounts work immediately by default. For email verification and password
# recovery, configure SMTP and change this to false.
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=StuffHub
